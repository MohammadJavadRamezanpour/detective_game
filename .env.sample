# Leave all provider keys empty to run the deterministic offline demo.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash-lite

QWEN_API_KEY=
QWEN_MODEL=qwen-plus

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional OpenAI-compatible local model (Ollama, vLLM, etc.).
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=phi3:mini

# Durable LangGraph checkpoints and browser origins.
CASEGRAPH_DB_PATH=.data/casegraph.sqlite
CASEGRAPH_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
